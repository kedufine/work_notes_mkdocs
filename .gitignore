# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Python & Virtualenv
.venv/
__pycache__/
*.py[cod]
*$py.class

# MkDocs Build Artifacts
/site/
mkdocs/site/

# Node (pretty-mermaid 스킬 의존성)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 인수인계 자료 원본과 변환 중간본 (개인정보 포함, 저장소에 올리지 않음)
# 원본 폴더 자리는 .gitkeep으로 유지한다
/1. RAW/*
!/1. RAW/.gitkeep
/2. 변환 중간본/

# 업무인수인계 질문지와 인계자 회신 파일 (개인정보 포함, 저장소에 올리지 않음)
/3. 업무인수인계 질문지/*
!/3. 업무인수인계 질문지/.gitkeep
